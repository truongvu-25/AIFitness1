<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="AppTheme.Base">

        <item name="android:windowLightNavigationBar">true</item>

        <!-- ================= SPLASH SCREEN ================= -->

        <!-- Background tối để logo Tri Force nổi -->
        <item name="android:windowSplashScreenBackground">
            @color/tri_force_splash_bg
        </item>

        <!-- Logo splash -->
        <item name="android:windowSplashScreenAnimatedIcon">
            @drawable/splash_logo
        </item>

        <!-- Không tạo ô nền khác màu phía sau logo -->
        <item name="android:windowSplashScreenIconBackgroundColor">
            @color/tri_force_splash_bg
        </item>

    </style>

</resources>
