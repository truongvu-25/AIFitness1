<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================================
         TRI FORCE — BASE APPLICATION THEME
         ========================================================= -->

    <style name="AppTheme.Base" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- ================= BRAND ================= -->

        <item name="colorPrimary">@color/mp_color_primary</item>
        <item name="colorPrimaryVariant">@color/mp_color_primary_variant</item>
        <item name="colorPrimaryDark">@color/mp_color_primary_dark</item>

        <item name="colorSecondary">@color/mp_color_secondary</item>
        <item name="colorSecondaryVariant">@color/mp_color_secondary_variant</item>

        <item name="colorError">@color/mp_color_error</item>


        <!-- ================= SURFACE ================= -->

        <item name="colorSurface">@color/tri_force_white</item>

        <item name="android:windowBackground">@color/tri_force_bg</item>

        <item name="android:colorAccent">@color/mp_color_primary</item>


        <!-- ================= STATUS BAR ================= -->

        <item name="android:statusBarColor">@color/toolbar_background</item>

        <!--
            Status bar đang là navy tối
            => icon status bar phải màu trắng
        -->
        <item name="android:windowLightStatusBar">false</item>


        <!-- ================= NAVIGATION BAR ================= -->

        <item name="android:navigationBarColor">@color/tri_force_bg</item>

        <!--
            Navigation bar sáng
            => icon Android màu tối
        -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>


        <!-- ================= WINDOW ================= -->

        <item name="android:windowNoTitle">true</item>

        <item name="android:windowActionModeOverlay">true</item>


        <!-- ================= TEXT ================= -->

        <item name="android:textColorPrimary">
            @color/tri_force_text_primary
        </item>

        <item name="android:textColorSecondary">
            @color/tri_force_text_secondary
        </item>


        <!-- ================= CONTROLS ================= -->

        <item name="colorControlNormal">
            @color/tri_force_icon_default
        </item>

        <item name="colorControlActivated">
            @color/mp_color_primary
        </item>

        <item name="colorControlHighlight">
            @color/tri_force_blue_light
        </item>


    </style>



    <style name="AppTheme" parent="AppTheme.Base" />


    <style
        name="TriForceButtonPrimary"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">
            @color/mp_color_primary
        </item>

        <item name="android:textColor">
            @color/tri_force_text_on_primary
        </item>

        <item name="android:textStyle">
            bold
        </item>

        <item name="android:textAllCaps">
            false
        </item>

        <item name="android:textSize">
            15sp
        </item>

        <item name="cornerRadius">
            @dimen/button_corner_radius
        </item>

        <item name="android:minHeight">
            50dp
        </item>

        <!-- Không dùng shadow nặng -->
        <item name="android:elevation">
            0dp
        </item>

        <item name="android:stateListAnimator">
            @null
        </item>

        <item name="rippleColor">
            @color/white_16
        </item>

    </style>

    <style
        name="TriForceButtonOutlined"
        parent="Widget.MaterialComponents.Button.OutlinedButton">

        <item name="backgroundTint">
            @color/tri_force_white
        </item>

        <item name="strokeColor">
            @color/mp_color_primary
        </item>

        <item name="strokeWidth">
            1dp
        </item>

        <item name="android:textColor">
            @color/mp_color_primary
        </item>

        <item name="android:textStyle">
            bold
        </item>

        <item name="android:textAllCaps">
            false
        </item>

        <item name="android:textSize">
            14sp
        </item>

        <item name="cornerRadius">
            @dimen/button_corner_radius
        </item>

        <item name="android:minHeight">
            48dp
        </item>

        <item name="android:elevation">
            0dp
        </item>

        <item name="android:stateListAnimator">
            @null
        </item>

        <item name="rippleColor">
            @color/tri_force_blue_light
        </item>

    </style>



    <style
        name="TriForceButtonText"
        parent="Widget.MaterialComponents.Button.TextButton">

        <item name="android:textColor">
            @color/mp_color_primary
        </item>

        <item name="android:textStyle">
            bold
        </item>

        <item name="android:textAllCaps">
            false
        </item>

        <item name="rippleColor">
            @color/tri_force_blue_light
        </item>

    </style>


    <style name="TriForceTextDisplay">

        <item name="android:textColor">
            @color/tri_force_text_primary
        </item>

        <item name="android:textSize">
            28sp
        </item>

        <item name="android:textStyle">
            bold
        </item>

    </style>


    <style name="TriForceTextTitle">

        <item name="android:textColor">
            @color/tri_force_text_primary
        </item>

        <item name="android:textSize">
            22sp
        </item>

        <item name="android:textStyle">
            bold
        </item>

    </style>


    <style name="TriForceTextHeading">

        <item name="android:textColor">
            @color/tri_force_text_primary
        </item>

        <item name="android:textSize">
            18sp
        </item>

        <item name="android:textStyle">
            bold
        </item>

    </style>


    <style name="TriForceTextBody">

        <item name="android:textColor">
            @color/tri_force_text_secondary
        </item>

        <item name="android:textSize">
            15sp
        </item>

    </style>


    <style name="TriForceTextCaption">

        <item name="android:textColor">
            @color/tri_force_text_tertiary
        </item>

        <item name="android:textSize">
            13sp
        </item>

    </style>


    <style
        name="BottomSheetSpinnerItemStyle"
        parent="Widget.AppCompat.Light.DropDownItem.Spinner">

        <item name="android:textSize">
            @dimen/bottom_sheet_text_size
        </item>

        <item name="android:textColor">
            @color/tri_force_text_primary
        </item>

    </style>


    <style name="AppThemeProgressStyle">

        <item name="colorAccent">
            @color/mp_color_primary
        </item>

    </style>

</resources>
