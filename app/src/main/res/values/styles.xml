<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Tri Force application theme with synchronized dark window background. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/mp_color_primary</item>
        <item name="colorPrimaryVariant">@color/mp_color_primary_variant</item>
        <item name="colorPrimaryDark">@color/mp_color_primary_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/mp_color_secondary</item>
        <item name="colorSecondaryVariant">@color/mp_color_secondary_variant</item>
        <item name="colorError">@color/mp_color_error</item>
        <!-- Status bar & Window background synced with logo dark background -->
        <item name="android:statusBarColor">@color/tri_force_navy</item>
        <item name="android:navigationBarColor">@color/tri_force_navy</item>
        <item name="android:windowBackground">@color/tri_force_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TriForceButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mp_color_primary</item>
        <item name="android:textColor">@color/tri_force_white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="TriForceButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/mp_color_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/mp_color_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="BottomSheetSpinnerItemStyle" parent="Widget.AppCompat.Light.DropDownItem.Spinner">
        <item name="android:textSize">@dimen/bottom_sheet_text_size</item>
    </style>

    <style name="AppThemeProgressStyle">
        <item name="colorAccent">@color/mp_color_primary_variant</item>
    </style>
</resources>
