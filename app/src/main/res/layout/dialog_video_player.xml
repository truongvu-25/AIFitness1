<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="16dp"
    app:cardBackgroundColor="@color/tri_force_surface_dark"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tri_force_surface_dark">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video hướng dẫn"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_text_on_dark"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="60dp"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:singleLine="true"/>

        <ImageButton
            android:id="@+id/btnDialogClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/tri_force_text_on_dark"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:layout_below="@id/tvDialogTitle"
            android:layout_marginBottom="12dp"
            android:background="@android:color/black">

            <VideoView
                android:id="@+id/dialogVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"/>

            <ProgressBar
                android:id="@+id/videoProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="visible"/>
        </FrameLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
