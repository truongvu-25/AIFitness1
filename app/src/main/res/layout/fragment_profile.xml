<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Profile Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginTop="@dimen/main_content_top_offset"
                app:cardCornerRadius="46dp"
                app:cardBackgroundColor="@color/tri_force_navy"
                app:cardElevation="6dp"
                app:strokeColor="@color/mp_color_primary_variant"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tri_force_logo"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_name_placeholder"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_text_primary"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_email_placeholder"
                android:textSize="13sp"
                android:textColor="@color/tri_force_text_secondary"
                android:layout_marginTop="2dp"/>

            <!-- BMI Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tri_force_dark_card"
                app:strokeColor="@color/tri_force_silver"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_body_metrics"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_text_primary"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/metric_age" android:textSize="12sp" android:textColor="@color/tri_force_slate"/>
                            <TextView android:id="@+id/tvProfileAge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/tri_force_text_primary" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/metric_height" android:textSize="12sp" android:textColor="@color/tri_force_slate"/>
                            <TextView android:id="@+id/tvProfileHeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/mp_color_primary" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/metric_weight" android:textSize="12sp" android:textColor="@color/tri_force_slate"/>
                            <TextView android:id="@+id/tvProfileWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/mp_color_primary" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tri_force_silver"
                        android:layout_marginVertical="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:weightSum="2">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/metric_bmi" android:textSize="12sp" android:textColor="@color/tri_force_slate"/>
                            <TextView android:id="@+id/tvProfileBmi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/mp_color_primary" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_fitness_status" android:textSize="12sp" android:textColor="@color/tri_force_slate"/>
                            <TextView android:id="@+id/tvProfileBmiType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/tri_force_white" android:background="@drawable/bg_bmi_badge" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daily Step Counter & Calorie Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStepCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tri_force_dark_card"
                app:strokeColor="@color/tri_force_silver"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_directions"
                            android:contentDescription="@null"
                            app:tint="@color/mp_color_primary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/step_counter_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_text_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@color/tri_force_success_bg"
                            android:padding="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_steps_label" android:textSize="12sp" android:textColor="@color/tri_force_success" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvProfileSteps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/tri_force_text_primary" android:layout_marginTop="2dp" tools:text="0 bước"/>
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@color/tri_force_warning_bg"
                            android:padding="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/calorie_burned_title" android:textSize="12sp" android:textColor="@color/tri_force_warning" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvProfileCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/value_not_available" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/tri_force_text_primary" android:layout_marginTop="2dp" tools:text="0.0 kcal"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Action Group Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tri_force_dark_card"
                app:strokeColor="@color/tri_force_silver"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Edit Profile Action Row -->
                    <LinearLayout
                        android:id="@+id/btnEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="15dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="19dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/tri_force_success_bg"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_profile_edit"
                                app:tint="@color/mp_color_primary"
                                android:contentDescription="@string/profile_edit_title"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_edit_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/tri_force_text_primary"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_edit_subtitle" android:textSize="12sp" android:textColor="@color/tri_force_text_secondary" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/tri_force_slate"
                            android:contentDescription="@string/profile_edit_title"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tri_force_silver"
                        android:layout_marginStart="70dp" />

                    <!-- Language Action Row -->
                    <LinearLayout
                        android:id="@+id/btnLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="15dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:text="@string/profile_language_icon"
                            android:textSize="20sp"
                            android:contentDescription="@string/profile_language_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_language_title"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/tri_force_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_language_subtitle"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCurrentLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_language_vi"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mp_color_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tri_force_silver"
                        android:layout_marginStart="70dp" />

                    <!-- Logout Action Row -->
                    <LinearLayout
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="15dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardCornerRadius="19dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/tri_force_error_bg"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_profile_logout"
                                app:tint="@color/tri_force_error"
                                android:contentDescription="@string/btn_logout"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_logout_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/tri_force_error"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_logout_subtitle" android:textSize="12sp" android:textColor="@color/tri_force_text_secondary" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/tri_force_slate"
                            android:contentDescription="@string/btn_logout"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
