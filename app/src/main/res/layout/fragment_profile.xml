<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Profile Avatar with Tri Force Ring -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="46dp"
                app:cardBackgroundColor="@color/tri_force_navy"
                app:cardElevation="2dp"
                app:strokeColor="@color/mp_color_primary_variant"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tri_force_logo"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và Tên"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_text_primary"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textSize="13sp"
                android:textColor="@color/tri_force_text_secondary"
                android:layout_marginTop="2dp"/>

            <!-- BMI Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tri_force_white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chỉ Số Cơ Thể &amp; Thể Trạng"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_text_primary"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tuổi"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chiều cao"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileHeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- cm"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cân nặng"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- kg"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chỉ số BMI"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileBmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thể trạng"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileBmiType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/tri_force_white"
                                android:background="@color/mp_color_primary"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Production Daily Step Counter & Calorie Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStepCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tri_force_white"
                app:strokeColor="@color/mp_color_primary"
                app:strokeWidth="1.5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_directions"
                            app:tint="@color/mp_color_primary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Đếm Bước Chân &amp; Calo Hàng Ngày"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/mp_color_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@color/tri_force_success_bg"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Số bước hôm nay"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_success"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvProfileSteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 bước"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#065F46"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@color/tri_force_warning_bg"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calo tiêu thụ"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_warning"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvProfileCalories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 kcal"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#92400E"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Personalized Health Advice Card Based on BMI & Calorie Burn -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBmiAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tri_force_warning_bg"
                app:strokeColor="@color/tri_force_warning"
                app:strokeWidth="1.5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvBmiAdviceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐÁNH GIÁ &amp; LỜI KHUYÊN VẬN ĐỘNG AI"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvBmiAdviceMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đang phân tích dữ liệu vận động hôm nay..."
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#451A03"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="CHỈNH SỬA HỒ SƠ"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="@color/mp_color_primary"
                app:cornerRadius="12dp"
                android:layout_marginTop="14dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="ĐĂNG XUẤT"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="@color/tri_force_error"
                app:cornerRadius="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
