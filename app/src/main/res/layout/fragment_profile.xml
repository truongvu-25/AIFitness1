<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Profile Avatar with Tri Force Ring -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginTop="56dp"
                app:cardCornerRadius="46dp"
                app:cardBackgroundColor="@color/tri_force_navy"
                app:cardElevation="6dp"
                app:strokeColor="@color/mp_color_primary_variant"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tri_force_logo"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và Tên"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textSize="13sp"
                android:textColor="@color/tri_force_silver"
                android:layout_marginTop="2dp"/>

            <!-- BMI Info Card (iOS Dark Glass) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CC0A192F"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1.2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chỉ Số Cơ Thể &amp; Thể Trạng"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/metric_age"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/tri_force_white"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/metric_height"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileHeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- cm"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary_variant"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/metric_weight"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- kg"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary_variant"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E3A8A"
                        android:layout_marginVertical="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/metric_bmi"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileBmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/mp_color_primary_variant"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thể trạng"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_slate"/>

                            <TextView
                                android:id="@+id/tvProfileBmiType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/tri_force_white"
                                android:background="@drawable/bg_bmi_badge"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daily Step Counter & Calorie Card (iOS Glass 2-Column) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStepCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CC0A192F"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1.2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_directions"
                            app:tint="@color/mp_color_primary_variant"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/step_counter_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#2610B981"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Số bước"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_success"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvProfileSteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 bước"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/tri_force_white"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#26F59E0B"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/calorie_burned_title"
                                android:textSize="12sp"
                                android:textColor="@color/tri_force_warning"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvProfileCalories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 kcal"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/tri_force_white"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Personalized AI Coach Advice Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBmiAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CC0A192F"
                app:strokeColor="@color/tri_force_warning"
                app:strokeWidth="1.2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvBmiAdviceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_advice_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_warning"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvBmiAdviceMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đang phân tích dữ liệu vận động hôm nay..."
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/tri_force_silver"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pill Action Buttons -->
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="CHỈNH SỬA HỒ SƠ"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="@color/mp_color_primary"
                app:cornerRadius="16dp"
                android:layout_marginTop="14dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_logout"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="#B3EF4444"
                app:cornerRadius="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
