<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Header Glass Card with Segmented Controls -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerLibraryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="88dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#CC0A192F"
        app:strokeColor="#1E3A8A"
        app:strokeWidth="1.2dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_title"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_subtitle"
                android:textSize="12sp"
                android:textColor="@color/tri_force_silver"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <!-- Primary 2-Mode Segmented Bar (Không Dụng Cụ vs Có Dụng Cụ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="#33030E20"
                android:padding="3dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnTabNoEquipment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/tab_no_equipment"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_white"
                    android:backgroundTint="@color/mp_color_primary"
                    app:cornerRadius="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <Button
                    android:id="@+id/btnTabWithEquipment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/tab_with_equipment"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_silver"
                    android:backgroundTint="@android:color/transparent"
                    app:cornerRadius="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <!-- Secondary Sub-Segmented Bar (Tại Nhà vs Phòng Gym) - Appears when Có Dụng Cụ is active -->
            <LinearLayout
                android:id="@+id/layoutSubTabs"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:background="#260066FF"
                android:padding="2dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnSubTabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🏠 Tại Nhà"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_white"
                    android:backgroundTint="@color/mp_color_primary_variant"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <Button
                    android:id="@+id/btnSubTabGym"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🏋️ Phòng Gym"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_silver"
                    android:backgroundTint="@android:color/transparent"
                    app:cornerRadius="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Exercise Library List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibraryExercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/headerLibraryCard"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_library_exercise"/>

</androidx.constraintlayout.widget.ConstraintLayout>
