<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/libraryAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvLibraryExercises">

        <!-- Everything below the global header collapses naturally with the list. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:minHeight="@dimen/main_content_top_offset"
            android:orientation="vertical"
            android:paddingTop="@dimen/main_content_top_offset"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/headerLibraryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:layout_marginEnd="@dimen/screen_horizontal_padding"
                app:cardBackgroundColor="@color/card_background_soft"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.12"
                                android:text="THƯ VIỆN"
                                android:textColor="@color/tri_force_blue"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:includeFontPadding="false"
                                android:text="@string/library_title"
                                android:textColor="@color/tri_force_text_primary"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:text="Khám phá bài tập theo hình thức luyện tập và dụng cụ."
                                android:textColor="@color/tri_force_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateCustom"
                            style="@style/TriForceButtonOutlined"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="@dimen/space_12"
                            android:minWidth="0dp"
                            android:paddingStart="@dimen/space_12"
                            android:paddingEnd="@dimen/space_12"
                            android:stateListAnimator="@null"
                            android:text="TẠO LỊCH"
                            android:textSize="10sp"
                            app:cornerRadius="10dp"
                            app:elevation="0dp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="Tìm bài tập, nhóm cơ, dụng cụ..."
                        app:boxBackgroundColor="@color/tri_force_white"
                        app:boxCornerRadiusBottomEnd="11dp"
                        app:boxCornerRadiusBottomStart="11dp"
                        app:boxCornerRadiusTopEnd="11dp"
                        app:boxCornerRadiusTopStart="11dp"
                        app:boxStrokeColor="@color/library_input_stroke"
                        app:boxStrokeWidth="@dimen/stroke_thin"
                        app:boxStrokeWidthFocused="@dimen/stroke_medium"
                        app:endIconMode="clear_text"
                        app:endIconTint="@color/tri_force_icon_default"
                        app:hintTextColor="@color/tri_force_text_tertiary"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:startIconTint="@color/tri_force_icon_default">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLibrarySearch"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/tri_force_text_primary"
                            android:textColorHighlight="@color/tri_force_blue_light"
                            android:textColorHint="@color/input_hint"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_library_segment_group"
                        android:orientation="horizontal"
                        android:padding="3dp"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabNoEquipment"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/tab_no_equipment"
                            android:textColor="@color/tri_force_white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/tri_force_blue"
                            app:cornerRadius="8dp"
                            app:elevation="0dp"
                            app:strokeColor="@color/tri_force_blue"
                            app:strokeWidth="@dimen/stroke_thin" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabWithEquipment"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/tab_with_equipment"
                            android:textColor="@color/tri_force_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/tri_force_white"
                            app:cornerRadius="8dp"
                            app:elevation="0dp"
                            app:strokeColor="@color/tri_force_stroke"
                            app:strokeWidth="@dimen/stroke_thin" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSubTabs"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@drawable/bg_library_segment_group"
                        android:orientation="horizontal"
                        android:padding="3dp"
                        android:visibility="gone"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubTabHome"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/subtab_home"
                            android:textColor="@color/tri_force_white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/tri_force_blue"
                            app:cornerRadius="8dp"
                            app:elevation="0dp"
                            app:strokeColor="@color/tri_force_blue"
                            app:strokeWidth="@dimen/stroke_thin" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubTabGym"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:stateListAnimator="@null"
                            android:text="@string/subtab_gym"
                            android:textColor="@color/tri_force_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/tri_force_white"
                            app:cornerRadius="8dp"
                            app:elevation="0dp"
                            app:strokeColor="@color/tri_force_stroke"
                            app:strokeWidth="@dimen/stroke_thin" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutLibraryResultHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/screen_horizontal_padding"
                android:layout_marginBottom="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Danh sách bài tập"
                        android:textColor="@color/tri_force_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="Vuốt lên để xem toàn bộ danh sách"
                        android:textColor="@color/tri_force_text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLibraryResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_library_chip"
                    android:includeFontPadding="false"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="0 bài tập"
                    android:textColor="@color/tri_force_blue"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="7 bài tập" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibraryExercises"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/space_24"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_library_exercise" />

    <LinearLayout
        android:id="@+id/tvLibraryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_32"
        android:layout_marginTop="@dimen/space_32"
        android:layout_marginEnd="@dimen/space_32"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Không tìm thấy bài tập"
            android:textColor="@color/tri_force_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:includeFontPadding="false"
            android:text="Thử một từ khóa hoặc bộ lọc khác."
            android:textAlignment="center"
            android:textColor="@color/tri_force_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
