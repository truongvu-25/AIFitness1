<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Header Glass Card with Segmented Controls -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerLibraryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="88dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#CC0A192F"
        app:strokeColor="#1E3A8A"
        app:strokeWidth="1.2dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnCreateCustom"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/library_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/tri_force_silver"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Custom Workout Creation Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="TỰ TẠO LỊCH TẬP"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/mp_color_primary_variant"
                    app:backgroundTint="#260066FF"
                    app:strokeColor="@color/mp_color_primary_variant"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp"
                    app:elevation="0dp"
                    android:paddingHorizontal="12dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </RelativeLayout>

            <!-- Primary 2-Mode Segmented Bar (Không Dụng Cụ vs Có Dụng Cụ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="#33030E20"
                android:padding="3dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabNoEquipment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/tab_no_equipment"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_white"
                    app:backgroundTint="@color/mp_color_primary"
                    app:cornerRadius="18dp"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabWithEquipment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/tab_with_equipment"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_silver"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="18dp"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>

            <!-- Secondary Sub-Segmented Bar (Tại Nhà vs Phòng Gym) - Appears when Có Dụng Cụ is active -->
            <LinearLayout
                android:id="@+id/layoutSubTabs"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:background="#260066FF"
                android:padding="2dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubTabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/subtab_home"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_white"
                    app:backgroundTint="@color/mp_color_primary_variant"
                    app:cornerRadius="16dp"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubTabGym"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/subtab_gym"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_silver"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="16dp"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Exercise Library List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibraryExercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/headerLibraryCard"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_library_exercise"/>

</androidx.constraintlayout.widget.ConstraintLayout>
