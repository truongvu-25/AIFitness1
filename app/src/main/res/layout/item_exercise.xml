<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="@dimen/space_4"
    android:layout_marginBottom="@dimen/space_8"

    app:cardBackgroundColor="@color/tri_force_white"

    app:cardCornerRadius="@dimen/card_corner_radius_small"

    app:cardElevation="0dp"

    app:strokeColor="@color/tri_force_stroke"
    app:strokeWidth="@dimen/stroke_thin">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal">


        <!-- =====================================================
             PERFORMANCE ACCENT
             ===================================================== -->

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"

            android:background="@color/tri_force_blue" />


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical"

            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_12">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <!-- Exercise name -->

                <TextView
                    android:id="@+id/tvExerciseName"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="Hít Đất (Push-up)"

                    android:textColor="@color/tri_force_text_primary"

                    android:textSize="17sp"
                    android:textStyle="bold"

                    android:maxLines="2"

                    android:lineSpacingExtra="1dp"

                    android:includeFontPadding="false" />


                <!-- Completed badge -->

                <TextView
                    android:id="@+id/tvStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/space_12"

                    android:background="@drawable/bg_badge_success"

                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"

                    android:text="HOÀN THÀNH"

                    android:textColor="@color/tri_force_success"

                    android:textSize="9sp"
                    android:textStyle="bold"

                    android:letterSpacing="0.04"

                    android:includeFontPadding="false"

                    android:visibility="gone" />

            </LinearLayout>


            <!-- =================================================
                 TARGET / PERFORMANCE META
                 ================================================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_8"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <!-- Small blue indicator -->

                <View
                    android:layout_width="18dp"
                    android:layout_height="2dp"

                    android:layout_marginEnd="@dimen/space_8"

                    android:background="@color/tri_force_blue" />


                <TextView
                    android:id="@+id/tvExerciseTarget"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Mục tiêu: 15 lần"

                    android:textColor="@color/tri_force_blue"

                    android:textSize="13sp"
                    android:textStyle="bold"

                    android:includeFontPadding="false" />

            </LinearLayout>


            <!-- =================================================
                 DESCRIPTION
                 ================================================= -->

            <TextView
                android:id="@+id/tvExerciseDesc"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_8"

                android:text="Giữ thẳng lưng, hạ ngực sát sàn rồi đẩy lên."

                android:textColor="@color/tri_force_text_secondary"

                android:textSize="13sp"

                android:lineSpacingExtra="2dp"

                android:maxLines="3"

                android:includeFontPadding="false" />


            <!-- =================================================
                 ACTION AREA
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_16"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <!-- Watch video -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchVideo"

                    style="@style/TriForceButtonOutlined"

                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"

                    android:layout_weight="1"

                    android:minWidth="0dp"

                    android:text="@string/btn_watch_video"

                    android:textSize="12sp"

                    android:letterSpacing="0.04"

                    app:elevation="0dp" />


                <!-- Gap -->

                <Space
                    android:layout_width="@dimen/space_12"
                    android:layout_height="1dp" />


                <!-- Start exercise -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartExercise"

                    style="@style/TriForceButtonPrimary"

                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"

                    android:layout_weight="1"

                    android:minWidth="0dp"

                    android:text="@string/btn_start_exercise"

                    android:textSize="12sp"

                    android:letterSpacing="0.04"

                    app:elevation="0dp" />


            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
