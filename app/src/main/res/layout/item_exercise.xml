<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hít Đất (Push Up)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212529"/>

            <TextView
                android:id="@+id/tvExerciseTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mục tiêu: 10 lần"
                android:textSize="14sp"
                android:textColor="#007F8B"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvExerciseDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giữ người thẳng, hạ thấp ngực xuống gần sàn rồi đẩy lên."
                android:textSize="12sp"
                android:textColor="#6C757D"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã hoàn thành"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:background="#E8F5E9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnWatchVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XEM VIDEO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#007F8B"
                android:backgroundTint="#E0F2F1"
                app:cornerRadius="6dp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btnStartExercise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BẮT ĐẦU"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#007F8B"
                app:cornerRadius="6dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
