<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#CC0A192F"
    app:strokeColor="#1E3A8A"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hít Đất (Push Up)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"/>

            <TextView
                android:id="@+id/tvExerciseTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mục tiêu: 10 lần"
                android:textSize="13sp"
                android:textColor="@color/mp_color_primary_variant"
                android:textStyle="bold"
                android:layout_marginTop="3dp"/>

            <TextView
                android:id="@+id/tvExerciseDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giữ người thẳng, hạ thấp ngực xuống gần sàn rồi đẩy lên."
                android:textSize="12sp"
                android:textColor="@color/tri_force_silver"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã hoàn thành"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_success"
                android:background="#2610B981"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnWatchVideo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_watch_video"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/mp_color_primary_variant"
                android:backgroundTint="#260066FF"
                app:strokeColor="@color/mp_color_primary_variant"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="6dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btnStartExercise"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_start_exercise"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="@color/mp_color_primary"
                app:cornerRadius="18dp"
                android:paddingHorizontal="14dp"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
