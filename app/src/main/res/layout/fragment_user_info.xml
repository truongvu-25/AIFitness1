<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg">

    <TextView
        android:id="@+id/tvUserInfoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_setup_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/tri_force_text_primary"
        android:layout_marginTop="88dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvQuestionProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/value_not_available"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/mp_color_primary"
        android:layout_marginTop="4dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvUserInfoTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <ProgressBar
        android:id="@+id/progressQuestions"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="20dp"
        android:max="100"
        android:progress="11"
        android:progressTint="@color/mp_color_primary"
        android:progressBackgroundTint="@color/tri_force_silver"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/progressQuestions"
        app:layout_constraintBottom_toTopOf="@id/panelInput"
        tools:listitem="@layout/item_chat_bot_message"/>

    <LinearLayout
        android:id="@+id/panelInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/tri_force_dark_card"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDynamicInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColorHint="@color/tri_force_slate"
            app:hintTextColor="@color/mp_color_primary"
            app:boxStrokeColor="@color/mp_color_primary"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDynamicInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tri_force_text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/containerChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"/>

        <FrameLayout
            android:id="@+id/containerHeightWheel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChatContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/continue_button"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            app:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <ProgressBar
            android:id="@+id/infoProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/mp_color_primary"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
