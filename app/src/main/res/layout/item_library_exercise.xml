<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="@dimen/space_4"
    android:layout_marginBottom="@dimen/space_8"

    android:clickable="true"
    android:focusable="true"

    android:foreground="?attr/selectableItemBackground"

    app:cardBackgroundColor="@color/tri_force_white"

    app:cardCornerRadius="@dimen/card_corner_radius_small"

    app:cardElevation="0dp"

    app:strokeColor="@color/tri_force_stroke"
    app:strokeWidth="@dimen/stroke_thin">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal">


        <!-- =====================================================
             SUBTLE PERFORMANCE RAIL
             ===================================================== -->

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"

            android:background="@color/tri_force_blue" />


        <!-- =====================================================
             CONTENT
             ===================================================== -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical"

            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_12">


            <!-- =================================================
                 TAGS
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <TextView
                    android:id="@+id/tvLibCategoryBadge"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:background="@drawable/bg_library_chip"

                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"

                    android:text="KHÔNG DỤNG CỤ"

                    android:textColor="@color/tri_force_blue"

                    android:textSize="8sp"
                    android:textStyle="bold"

                    android:letterSpacing="0.03"

                    android:includeFontPadding="false" />


                <TextView
                    android:id="@+id/tvLibEquipmentTag"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/space_8"

                    android:background="@drawable/bg_library_chip"

                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"

                    android:text="Bodyweight"

                    android:textColor="@color/tri_force_text_secondary"

                    android:textSize="8sp"
                    android:textStyle="bold"

                    android:maxLines="1"

                    android:includeFontPadding="false" />


            </LinearLayout>


            <!-- =================================================
                 NAME
                 ================================================= -->

            <TextView
                android:id="@+id/tvLibExerciseName"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_12"

                android:text="Hít Đất (Push-up)"

                android:textColor="@color/tri_force_text_primary"

                android:textSize="17sp"
                android:textStyle="bold"

                android:maxLines="2"

                android:lineSpacingExtra="1dp"

                android:includeFontPadding="false" />


            <!-- =================================================
                 DESCRIPTION
                 ================================================= -->

            <TextView
                android:id="@+id/tvLibExerciseDesc"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_8"

                android:text="Phát triển cơ ngực, vai và tay sau."

                android:textColor="@color/tri_force_text_secondary"

                android:textSize="12sp"

                android:lineSpacingExtra="2dp"

                android:maxLines="2"

                android:ellipsize="end"

                android:includeFontPadding="false" />


            <!-- =================================================
                 TARGET + VIDEO
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_12"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="horizontal"

                    android:gravity="center_vertical">


                    <View
                        android:layout_width="16dp"
                        android:layout_height="2dp"

                        android:layout_marginEnd="@dimen/space_8"

                        android:background="@color/tri_force_blue" />


                    <TextView
                        android:id="@+id/tvLibExerciseTarget"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Mục tiêu: 15 lần"

                        android:textColor="@color/tri_force_blue"

                        android:textSize="11sp"
                        android:textStyle="bold"

                        android:includeFontPadding="false" />


                </LinearLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLibWatchVideo"

                    android:layout_width="wrap_content"
                    android:layout_height="36dp"

                    android:layout_marginStart="@dimen/space_12"

                    android:minWidth="0dp"
                    android:stateListAnimator="@null"

                    android:text="XEM VIDEO"

                    android:textColor="@color/tri_force_blue"

                    android:textSize="9sp"
                    android:textStyle="bold"

                    android:letterSpacing="0.03"

                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"

                    app:backgroundTint="@color/tri_force_white"

                    app:strokeColor="@color/tri_force_blue"
                    app:strokeWidth="@dimen/stroke_thin"

                    app:cornerRadius="9dp"

                    app:elevation="0dp"

                    android:insetTop="0dp"
                    android:insetBottom="0dp"

                    style="@style/Widget.MaterialComponents.Button" />


            </LinearLayout>


        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
