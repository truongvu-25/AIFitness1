<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/tri_force_white"
    app:strokeColor="@color/tri_force_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvLibCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_exercise_no_equipment"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/mp_color_primary_variant"
                    android:background="#260066FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"/>

                <TextView
                    android:id="@+id/tvLibEquipmentTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bodyweight"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_text_secondary"
                    android:background="#1AFFFFFF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLibExerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_name_pushup"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_text_primary"/>

            <TextView
                android:id="@+id/tvLibExerciseTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_target_placeholder"
                android:textSize="13sp"
                android:textColor="@color/mp_color_primary_variant"
                android:textStyle="bold"
                android:layout_marginTop="3dp"/>

            <TextView
                android:id="@+id/tvLibExerciseDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_library_desc_pushup"
                android:textSize="12sp"
                android:textColor="@color/tri_force_text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLibWatchVideo"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/btn_watch_video"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            app:backgroundTint="@color/mp_color_primary"
            app:strokeColor="@color/mp_color_primary_variant"
            app:strokeWidth="1dp"
            app:cornerRadius="19dp"
            app:elevation="0dp"
            android:paddingHorizontal="14dp"
            android:layout_marginStart="12dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
