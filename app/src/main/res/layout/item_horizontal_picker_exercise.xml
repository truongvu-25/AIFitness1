<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="168dp"
    android:layout_height="148dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/tri_force_white"
    app:strokeColor="@color/tri_force_stroke"
    app:strokeWidth="@dimen/stroke_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPickerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bodyweight"
            android:textSize="9sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:textColor="@color/tri_force_blue"
            android:background="@drawable/bg_library_chip"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPickerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hít Đất (Push-up)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_text_primary"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvPickerTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 lần"
            android:textSize="11sp"
            android:textColor="@color/tri_force_blue"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToDay"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="+ THÊM"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            app:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
