<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg">

    <!-- Collapses with the exercise list while preserving room for the global header. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/calendarAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvExercises">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/main_content_top_offset"
            android:orientation="vertical"
            android:paddingTop="@dimen/main_content_top_offset"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/headerPlanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:layout_marginEnd="@dimen/screen_horizontal_padding"
                app:cardBackgroundColor="@color/tri_force_white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <LinearLayout
                    android:id="@+id/headerPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.12"
                        android:text="KẾ HOẠCH 30 NGÀY"
                        android:textColor="@color/tri_force_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlanType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="Đang tải lộ trình..."
                        android:textColor="@color/tri_force_navy"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        tools:text="Lộ trình: Săn Chắc Thể Hình" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:text="Theo dõi từng ngày, duy trì nhịp tập và hoàn thành mục tiêu của bạn."
                        android:textColor="@color/tri_force_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="52dp"
                            android:layout_height="3dp"
                            android:background="@color/tri_force_blue" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetPlan"
                            style="@style/TriForceButtonOutlined"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height_small"
                            android:minWidth="0dp"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="@dimen/space_16"
                            android:text="@string/btn_create_new_plan"
                            android:textColor="@color/tri_force_blue"
                            android:textSize="11sp"
                            app:backgroundTint="@color/tri_force_white"
                            app:elevation="0dp"
                            app:strokeColor="@color/tri_force_blue" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDays"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calendar_day_strip_height"
                android:layout_marginTop="@dimen/space_8"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingEnd="@dimen/screen_horizontal_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_workout_day" />

            <TextView
                android:id="@+id/tvSelectedDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/screen_horizontal_padding"
                android:includeFontPadding="false"
                android:text="@string/today_workout_title"
                android:textColor="@color/tri_force_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Bài tập Ngày 2 • 01/09" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_horizontal_padding"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_horizontal_padding"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tri_force_surface_soft"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        android:id="@+id/ivNoticeIcon"
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:layout_marginEnd="@dimen/space_12"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="@color/tri_force_info" />

                    <TextView
                        android:id="@+id/tvNoticeMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Thông báo trạng thái ngày tập"
                        android:textColor="@color/tri_force_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_8" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExercises"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/calendar_list_bottom_padding"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_exercise" />

    <ProgressBar
        android:id="@+id/calendarProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/mp_color_primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
