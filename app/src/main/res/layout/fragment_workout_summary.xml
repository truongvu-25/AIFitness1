<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="HOÀN THÀNH BUỔI TẬP"
                android:textColor="@color/tri_force_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:includeFontPadding="false"
                android:text="Tuyệt vời!"
                android:textColor="@color/tri_force_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryExerciseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:includeFontPadding="false"
                android:textColor="@color/tri_force_text_secondary"
                android:textSize="15sp"
                tools:text="Hít Đất (Push-up) • Ngày 3" />

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_badge_info"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Đã lưu trên thiết bị • đang tự đồng bộ"
                android:textColor="@color/tri_force_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                app:cardBackgroundColor="@color/tri_force_navy"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="ĐIỂM KỸ THUẬT AI"
                        android:textColor="@color/tri_force_text_on_dark_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSummaryScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:includeFontPadding="false"
                        android:textColor="@color/tri_force_white"
                        android:textSize="46sp"
                        android:textStyle="bold"
                        tools:text="86" />

                    <TextView
                        android:id="@+id/tvSummaryScoreLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Tư thế tốt"
                        android:textColor="@color/tri_force_blue_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/tri_force_white"
                    app:cardCornerRadius="@dimen/card_corner_radius_small"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/tri_force_stroke"
                    app:strokeWidth="@dimen/stroke_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:id="@+id/tvSummaryActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/tri_force_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="48/48" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:includeFontPadding="false"
                            android:text="KẾT QUẢ"
                            android:textColor="@color/tri_force_text_tertiary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/tri_force_white"
                    app:cardCornerRadius="@dimen/card_corner_radius_small"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/tri_force_stroke"
                    app:strokeWidth="@dimen/stroke_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:id="@+id/tvSummaryDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/tri_force_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="02:14" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:includeFontPadding="false"
                            android:text="THỜI GIAN"
                            android:textColor="@color/tri_force_text_tertiary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardComparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/tri_force_surface_soft"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <TextView
                    android:id="@+id/tvComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_8"
                    android:includeFontPadding="false"
                    android:padding="@dimen/space_16"
                    android:textColor="@color/tri_force_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Tăng 3 lần và 5 điểm kỹ thuật so với buổi trước." />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:includeFontPadding="false"
                android:text="AI nhận xét"
                android:textColor="@color/tri_force_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:cardBackgroundColor="@color/tri_force_white"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <TextView
                    android:id="@+id/tvFormSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:padding="@dimen/space_16"
                    android:textColor="@color/tri_force_text_secondary"
                    android:textSize="13sp"
                    tools:text="• Hạ thấp người xuống thêm.\n• Giữ lưng thẳng trong toàn bộ chuyển động." />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:includeFontPadding="false"
                android:text="Mức độ buổi tập"
                android:textColor="@color/tri_force_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:includeFontPadding="false"
                android:text="Phản hồi này sẽ giúp AI điều chỉnh buổi tập tiếp theo."
                android:textColor="@color/tri_force_text_tertiary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDifficultyEasy"
                    style="@style/TriForceButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="Quá nhẹ +20%"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDifficultyRight"
                    style="@style/TriForceButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="Vừa sức 0%"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDifficultyHard"
                    style="@style/TriForceButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="Quá nặng −20%"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/adaptiveRecommendationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tri_force_blue_soft"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_blue_light"
                app:strokeWidth="@dimen/stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="MỤC TIÊU GỢI Ý CHO BUỔI SAU"
                        android:textColor="@color/tri_force_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdaptiveRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/tri_force_text_primary"
                        android:textSize="13sp"
                        tools:text="Tăng nhẹ lên 53 lần để tiếp tục tiến bộ mà vẫn giữ kỹ thuật ổn định." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyRecommendedTarget"
                        style="@style/TriForceButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_small"
                        android:layout_marginTop="@dimen/space_12"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="ÁP DỤNG CHO CÁC BUỔI SẮP TỚI"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSummaryRepeat"
                style="@style/TriForceButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_20"
                android:text="TẬP LẠI BÀI NÀY"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSummaryContinue"
        style="@style/TriForceButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        android:layout_marginBottom="@dimen/space_20"
        android:text="TIẾP TỤC LỘ TRÌNH"
        android:textSize="13sp"
        app:elevation="2dp" />

</FrameLayout>
