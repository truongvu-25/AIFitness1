<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Active Weekly Plan Glass Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="88dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#CC0A192F"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIẾN TRÌNH TẬP HÀNG TUẦN"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/mp_color_primary_variant"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tvPlanBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lặp lại tuần"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_success"
                            android:background="#2610B981"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHomePlanName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch tập cá nhân của tôi"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"/>

                    <!-- 7-Day Mini Indicator Strip -->
                    <LinearLayout
                        android:id="@+id/layoutWeekBubbles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7"
                        android:layout_marginTop="14dp">

                        <!-- T2 -->
                        <TextView
                            android:id="@+id/bubbleMon"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="T2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>

                        <!-- T3 -->
                        <TextView
                            android:id="@+id/bubbleTue"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="T3"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>

                        <!-- T4 -->
                        <TextView
                            android:id="@+id/bubbleWed"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="T4"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>

                        <!-- T5 -->
                        <TextView
                            android:id="@+id/bubbleThu"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="T5"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>

                        <!-- T6 -->
                        <TextView
                            android:id="@+id/bubbleFri"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="T6"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>

                        <!-- T7 -->
                        <TextView
                            android:id="@+id/bubbleSat"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="T7"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>

                        <!-- CN -->
                        <TextView
                            android:id="@+id/bubbleSun"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:text="CN"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tri_force_white"
                            android:background="@drawable/bg_bmi_badge"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today Header Title -->
            <TextView
                android:id="@+id/tvTodayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BÀI TẬP HÔM NAY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:letterSpacing="0.04"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <!-- Empty Plan / Rest Day Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeEmptyPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#CC0A192F"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/ivEmptyIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/tri_force_logo"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_name"/>

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa Có Lịch Tập Tuần"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hãy vào Thư viện và bấm 'Tự tạo lịch tập' để thiết lập tiến trình tập luyện riêng cho bạn."
                        android:textSize="12sp"
                        android:textColor="@color/tri_force_silver"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeCreatePlan"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="TỰ TẠO LỊCH TẬP NGAY"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        app:backgroundTint="@color/mp_color_primary"
                        app:cornerRadius="18dp"
                        app:elevation="0dp"
                        android:paddingHorizontal="18dp"
                        style="@style/Widget.MaterialComponents.Button"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Exercise List Container -->
            <LinearLayout
                android:id="@+id/layoutTodayExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
