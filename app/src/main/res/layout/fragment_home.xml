<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/tri_force_bg">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"
        android:scrollbars="none"

        android:clipToPadding="false"

        android:paddingBottom="@dimen/space_24"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:layout_marginTop="@dimen/main_content_top_offset"

            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingEnd="@dimen/screen_horizontal_padding">


            <!-- =================================================
                 PERFORMANCE HERO
                 ================================================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"

                android:background="@drawable/bg_ai_home_hero">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:orientation="vertical"

                    android:padding="@dimen/card_padding">


                    <!-- Top hero meta -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"

                        android:gravity="center_vertical">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal"

                            android:gravity="center_vertical">


                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"

                                android:background="@color/tri_force_blue" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginStart="@dimen/space_8"

                                android:text="@string/home_today_badge"

                                android:textColor="@color/tri_force_blue"

                                android:textSize="9sp"
                                android:textStyle="bold"

                                android:letterSpacing="0.12"

                                android:includeFontPadding="false" />


                        </LinearLayout>


                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"

                            android:layout_weight="1" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/brand_calisthenics"

                            android:textColor="@color/tri_force_text_on_dark_secondary"

                            android:textSize="8sp"
                            android:textStyle="bold"

                            android:letterSpacing="0.10"

                            android:includeFontPadding="false" />
                    </LinearLayout>


                    <!-- User -->

                    <TextView
                        android:id="@+id/tvHomeGreetingName"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/space_12"

                        android:text="@string/home_greeting_default"

                        android:textColor="@color/tri_force_navy"

                        android:textSize="25sp"
                        android:textStyle="bold"

                        android:maxLines="1"
                        android:ellipsize="end"

                        android:includeFontPadding="false"

                        tools:text="Pham Gia Huy" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/space_4"

                        android:text="@string/home_greeting_subtitle"

                        android:textColor="@color/tri_force_text_secondary"

                        android:textSize="11sp"

                        android:lineSpacingExtra="2dp"

                        android:maxLines="2"

                        android:includeFontPadding="false" />


                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"

                        android:layout_weight="1" />


                    <!-- =================================================
                         TODAY METRICS
                         ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="62dp"

                        app:cardBackgroundColor="@color/tri_force_white"

                        app:cardCornerRadius="11dp"

                        app:cardElevation="0dp"

                        app:strokeColor="@color/tri_force_stroke"
                        app:strokeWidth="@dimen/stroke_thin">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:orientation="horizontal"

                            android:weightSum="3">


                            <!-- Exercise -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"

                                android:layout_weight="1"

                                android:orientation="vertical"

                                android:gravity="center">


                                <TextView
                                    android:id="@+id/tvHomeTodayExercises"

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:text="@string/home_count_placeholder"

                                    android:textColor="@color/tri_force_navy"

                                    android:textSize="19sp"
                                    android:textStyle="bold"

                                    android:includeFontPadding="false" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginTop="3dp"

                                    android:text="@string/home_stat_exercises"

                                    android:textColor="@color/tri_force_text_secondary"

                                    android:textSize="9sp"

                                    android:includeFontPadding="false" />


                            </LinearLayout>


                            <View
                                android:layout_width="1dp"
                                android:layout_height="32dp"

                                android:layout_gravity="center_vertical"

                                android:background="@color/tri_force_divider" />


                            <!-- Steps -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"

                                android:layout_weight="1"

                                android:orientation="vertical"

                                android:gravity="center">


                                <TextView
                                    android:id="@+id/tvHomeSteps"

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:text="@string/home_zero"

                                    android:textColor="@color/tri_force_navy"

                                    android:textSize="19sp"
                                    android:textStyle="bold"

                                    android:includeFontPadding="false" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginTop="3dp"

                                    android:text="@string/home_stat_steps"

                                    android:textColor="@color/tri_force_text_secondary"

                                    android:textSize="9sp"

                                    android:includeFontPadding="false" />


                            </LinearLayout>


                            <View
                                android:layout_width="1dp"
                                android:layout_height="32dp"

                                android:layout_gravity="center_vertical"

                                android:background="@color/tri_force_divider" />


                            <!-- Calories -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"

                                android:layout_weight="1"

                                android:orientation="vertical"

                                android:gravity="center">


                                <TextView
                                    android:id="@+id/tvHomeCalories"

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:text="@string/home_zero"

                                    android:textColor="@color/tri_force_blue"

                                    android:textSize="19sp"
                                    android:textStyle="bold"

                                    android:includeFontPadding="false" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_marginTop="3dp"

                                    android:text="@string/home_stat_calories"

                                    android:textColor="@color/tri_force_text_secondary"

                                    android:textSize="9sp"

                                    android:includeFontPadding="false" />


                            </LinearLayout>


                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>


            </FrameLayout>


            <!-- =================================================
                 CURRENT PLAN SECTION
                 ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_12"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="@string/home_current_plan"

                    android:textColor="@color/tri_force_text_primary"

                    android:textSize="17sp"
                    android:textStyle="bold"

                    android:includeFontPadding="false" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/home_program_30_day"

                    android:textColor="@color/tri_force_blue"

                    android:textSize="8sp"
                    android:textStyle="bold"

                    android:letterSpacing="0.09"

                    android:includeFontPadding="false" />


            </LinearLayout>


            <!-- =================================================
                 ACTIVE PLAN
                 ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivePlan"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_8"

                android:visibility="gone"

                android:clickable="true"
                android:focusable="true"

                android:foreground="?attr/selectableItemBackground"

                app:cardBackgroundColor="@color/tri_force_white"

                app:cardCornerRadius="@dimen/card_corner_radius_small"

                app:cardElevation="0dp"

                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">


                    <!-- Strong performance accent -->

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"

                        android:background="@color/tri_force_blue" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical"

                        android:padding="@dimen/card_padding">


                        <TextView
                            android:id="@+id/tvPlanBadge"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/home_program_30_day"

                            android:textColor="@color/tri_force_blue"

                            android:textSize="9sp"
                            android:textStyle="bold"

                            android:letterSpacing="0.09"

                            android:includeFontPadding="false" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="@dimen/space_8"

                            android:orientation="horizontal"

                            android:gravity="center_vertical">


                            <TextView
                                android:id="@+id/tvHomePlanName"

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:text="@string/home_plan_default_balanced"

                                android:textColor="@color/tri_force_text_primary"

                                android:textSize="18sp"
                                android:textStyle="bold"

                                android:maxLines="2"

                                android:includeFontPadding="false"

                                tools:text="Săn Chắc Thể Hình" />


                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGoToCurrentWorkout"

                                android:layout_width="42dp"
                                android:layout_height="42dp"

                                android:layout_marginStart="@dimen/space_12"

                                android:minWidth="0dp"
                                android:minHeight="0dp"

                                android:padding="0dp"

                                android:text="@string/home_chevron"

                                android:textColor="@color/tri_force_white"

                                android:textSize="25sp"

                                android:stateListAnimator="@null"

                                app:backgroundTint="@color/tri_force_blue"

                                app:cornerRadius="10dp"

                                app:elevation="0dp" />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="@dimen/space_12"

                            android:orientation="horizontal"

                            android:gravity="center_vertical">


                            <TextView
                                android:id="@+id/tvHomePlanDay"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="@string/home_plan_day_placeholder"

                                android:textColor="@color/tri_force_blue"

                                android:textSize="11sp"
                                android:textStyle="bold"

                                android:includeFontPadding="false" />


                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"

                                android:layout_weight="1" />


                            <TextView
                                android:id="@+id/tvHomePlanProgress"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="@string/home_progress_placeholder"

                                android:textColor="@color/tri_force_text_secondary"

                                android:textSize="10sp"
                                android:textStyle="bold"

                                android:includeFontPadding="false" />


                        </LinearLayout>


                        <ProgressBar
                            android:id="@+id/progressHomePlan"

                            style="?android:attr/progressBarStyleHorizontal"

                            android:layout_width="match_parent"
                            android:layout_height="5dp"

                            android:layout_marginTop="@dimen/space_4"

                            android:max="100"
                            android:progress="3"

                            android:progressTint="@color/tri_force_blue"

                            android:progressBackgroundTint="@color/progress_track" />


                        <!-- Legacy weekly IDs -->

                        <LinearLayout
                            android:id="@+id/layoutWeekBubbles"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:visibility="gone"

                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/bubbleMon"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_mon_short" />

                            <TextView
                                android:id="@+id/bubbleTue"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_tue_short" />

                            <TextView
                                android:id="@+id/bubbleWed"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_wed_short" />

                            <TextView
                                android:id="@+id/bubbleThu"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_thu_short" />

                            <TextView
                                android:id="@+id/bubbleFri"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_fri_short" />

                            <TextView
                                android:id="@+id/bubbleSat"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_sat_short" />

                            <TextView
                                android:id="@+id/bubbleSun"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="@string/weekday_sun_short" />


                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 EMPTY PLAN
                 ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeEmptyPrompt"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_8"

                app:cardBackgroundColor="@color/tri_force_white"

                app:cardCornerRadius="@dimen/card_corner_radius_small"

                app:cardElevation="0dp"

                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:gravity="center_vertical"

                    android:padding="@dimen/card_padding">


                    <ImageView
                        android:id="@+id/ivEmptyIcon"

                        android:layout_width="42dp"
                        android:layout_height="42dp"

                        android:src="@drawable/tri_force_logo"

                        android:scaleType="centerCrop"

                        android:contentDescription="@string/app_name" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:layout_marginStart="@dimen/space_12"
                        android:layout_marginEnd="@dimen/space_12"

                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/tvEmptyTitle"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="@string/home_empty_title"

                            android:textColor="@color/tri_force_text_primary"

                            android:textSize="13sp"
                            android:textStyle="bold"

                            android:includeFontPadding="false" />


                        <TextView
                            android:id="@+id/tvEmptySubtitle"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="@string/home_empty_subtitle"

                            android:textColor="@color/tri_force_text_secondary"

                            android:textSize="9sp"

                            android:maxLines="2"

                            android:includeFontPadding="false" />


                    </LinearLayout>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeCreatePlan"

                        android:layout_width="wrap_content"
                        android:layout_height="38dp"

                        android:minWidth="0dp"

                        android:text="@string/home_create"

                        android:textColor="@color/tri_force_white"

                        android:textSize="10sp"
                        android:textStyle="bold"

                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12"

                        app:backgroundTint="@color/tri_force_blue"

                        app:cornerRadius="9dp"

                        app:elevation="0dp" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 PROGRESS DASHBOARD CARD
                 ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/tri_force_white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="@color/tri_force_blue_soft"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/progress_latest_result"
                            android:src="@drawable/ic_progress_chart"
                            app:tint="@color/tri_force_blue" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiến Trình &amp; Mục Tiêu"
                            android:textColor="@color/tri_force_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Xem xu hướng, chuỗi ngày và phân tích AI"
                            android:textColor="@color/tri_force_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/action_details"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/tri_force_steel" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
                 SAVED PLANS
                 ================================================= -->

            <TextView
                android:id="@+id/tvSavedPlansHeader"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_8"

                android:text="@string/home_saved_plans"

                android:textColor="@color/tri_force_text_primary"

                android:textSize="16sp"
                android:textStyle="bold"

                android:includeFontPadding="false"

                android:visibility="gone" />


            <LinearLayout
                android:id="@+id/layoutSavedPlansList"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:visibility="gone" />


            <!-- =================================================
                 LEGACY IDS
                 ================================================= -->

            <TextView
                android:id="@+id/tvTodayTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="@string/home_today_exercises"

                android:visibility="gone" />


            <LinearLayout
                android:id="@+id/layoutTodayExercises"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:visibility="gone" />


            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/space_32" />


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
