<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg">

    <!-- Top Sticky Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nav_background"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/space_12"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                app:tint="@color/tri_force_white"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/profile_title"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TỰ TẠO LỊCH TẬP TUẦN"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:letterSpacing="0.04"
                android:layout_centerInParent="true"/>
        </RelativeLayout>

        <!-- Plan Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên lịch tập của bạn"
            android:textColorHint="@color/input_hint"
            app:hintTextColor="@color/tri_force_text_on_dark_secondary"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/tri_force_surface_dark_alt"
            app:boxStrokeColor="@color/tri_force_blue"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlanName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lịch tập cá nhân của tôi"
                android:textColor="@color/tri_force_white"
                android:textSize="14sp"
                android:inputType="textCapWords"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Upper 1/3 Section: Exercise Picker Category & Horizontal Carousel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUpperPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_padding"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/screen_horizontal_padding"
        app:cardCornerRadius="@dimen/card_corner_radius_small"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/tri_force_white"
        app:strokeColor="@color/tri_force_stroke"
        app:strokeWidth="@dimen/stroke_thin"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 3 Category Filter Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_library_segment_group"
                android:padding="2dp"
                android:weightSum="3"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickerNoEquip"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Không dụng cụ"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:textColor="@color/tri_force_white"
                    app:backgroundTint="@color/mp_color_primary"
                    app:cornerRadius="9dp"
                    app:strokeColor="@color/tri_force_blue"
                    app:strokeWidth="@dimen/stroke_thin"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickerHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Tại nhà"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:textColor="@color/tri_force_text_secondary"
                    app:backgroundTint="@color/tri_force_white"
                    app:cornerRadius="9dp"
                    app:strokeColor="@color/tri_force_stroke"
                    app:strokeWidth="@dimen/stroke_thin"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickerGym"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Phòng gym"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:textColor="@color/tri_force_text_secondary"
                    app:backgroundTint="@color/tri_force_white"
                    app:cornerRadius="9dp"
                    app:strokeColor="@color/tri_force_stroke"
                    app:strokeWidth="@dimen/stroke_thin"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>

            <!-- Horizontal Exercise Scrolling Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHorizontalExercises"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_horizontal_picker_exercise"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvWeeklyScheduleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LỊCH TẬP HÀNG TUẦN • THỨ 2 – CHỦ NHẬT"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/tri_force_blue"
        android:letterSpacing="0.04"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardUpperPicker"/>

    <!-- Lower 2/3 Section: Vertical List of 7 Days of the Week -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWeeklyDays"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tvWeeklyScheduleTitle"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar"
        tools:listitem="@layout/item_day_schedule_card"/>

    <!-- Bottom Action Bar (HỦY & LƯU) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:background="@color/tri_force_white"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPlan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="HỦY"
            android:textSize="13sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:textColor="@color/tri_force_blue"
            app:backgroundTint="@color/tri_force_white"
            app:cornerRadius="@dimen/button_corner_radius"
            app:strokeColor="@color/tri_force_blue"
            app:strokeWidth="@dimen/stroke_thin"
            app:elevation="0dp"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePlan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="LƯU LỊCH TẬP"
            android:textSize="13sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:textColor="@color/tri_force_white"
            app:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="@dimen/button_corner_radius"
            app:elevation="0dp"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
