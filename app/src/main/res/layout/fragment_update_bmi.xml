<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_bg"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingEnd="@dimen/screen_horizontal_padding">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tri_force_stroke_medium"
                app:strokeWidth="@dimen/stroke_thin">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tri_force_logo"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cập Nhật Chỉ Số Cơ Thể"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã hơn 7 ngày kể từ lần cập nhật chỉ số gần nhất. Vui lòng nhập chiều cao và cân nặng hiện tại để Tri Force tính toán lại chỉ số BMI tối ưu nhất cho bạn."
                android:textSize="13sp"
                android:textColor="@color/tri_force_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="28dp"
                android:paddingHorizontal="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/tri_force_white"
                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chiều cao mới (cm)"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundColor="@color/input_background"
                        app:boxStrokeColor="@color/library_input_stroke"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUpdateHeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_text_primary"
                            android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cân nặng mới (kg)"
                        android:layout_marginBottom="24dp"
                        app:boxBackgroundColor="@color/input_background"
                        app:boxStrokeColor="@color/library_input_stroke"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUpdateWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_text_primary"
                            android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnUpdateBmi"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="CẬP NHẬT CHỈ SỐ BMI"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:backgroundTint="@color/mp_color_primary"
                        app:cornerRadius="12dp"/>

                    <ProgressBar
                        android:id="@+id/updateBmiProgress"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/mp_color_primary"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
