<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_navy"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Header Branding Section -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardCornerRadius="42dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/tri_force_navy"
                    app:strokeColor="@color/mp_color_primary_variant"
                    app:strokeWidth="2.5dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tri_force_logo"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/app_name"/>
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/ivTitleLogo"
                    android:layout_width="220dp"
                    android:layout_height="56dp"
                    android:src="@drawable/tri_force_text_logo"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập để tiếp tục hành trình tập luyện"
                    android:textSize="13sp"
                    android:textColor="@color/tri_force_silver"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Dark Themed Login Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/tri_force_dark_card"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1.5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐĂNG NHẬP"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="20dp"
                        android:layout_gravity="center_horizontal"/>

                    <!-- Email Input Field with Clear Purpose & Placeholder -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Địa chỉ Email đăng nhập"
                        android:textColorHint="#94A3B8"
                        app:hintTextColor="@color/mp_color_primary_variant"
                        app:placeholderText="vidu: athlete@gmail.com"
                        app:placeholderTextColor="#64748B"
                        android:layout_marginBottom="18dp"
                        app:boxStrokeColor="@color/mp_color_primary_variant"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_white"
                            android:textColorHighlight="#330066FF"
                            android:inputType="textEmailAddress"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input Field with Clear Purpose & Placeholder -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mật khẩu bảo mật"
                        android:textColorHint="#94A3B8"
                        app:hintTextColor="@color/mp_color_primary_variant"
                        app:placeholderText="Nhập mật khẩu của bạn"
                        app:placeholderTextColor="#64748B"
                        android:layout_marginBottom="24dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/mp_color_primary_variant"
                        app:boxStrokeColor="@color/mp_color_primary_variant"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_white"
                            android:textColorHighlight="#330066FF"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="ĐĂNG NHẬP"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:letterSpacing="0.08"
                        android:backgroundTint="@color/mp_color_primary"
                        app:cornerRadius="14dp"
                        app:elevation="6dp"/>

                    <ProgressBar
                        android:id="@+id/loadingProgress"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/mp_color_primary_variant"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Redirect to Register -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có tài khoản?"
                    android:textColor="@color/tri_force_silver"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvGoToRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Đăng ký ngay"
                    android:textColor="@color/mp_color_primary_variant"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:padding="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
