<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_navy">

    <!-- Global Full-Screen Gym Interior Background -->
    <ImageView
        android:id="@+id/ivGlobalBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/app_main_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <!-- Subtle Dark Layer for High Contrast Depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66030E20" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-Screen Fragment Navigation Host Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@id/bottomNavCard"
            android:background="@android:color/transparent"
            android:keepScreenOn="true"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph"
            tools:context=".MainActivity" />

        <!-- iOS-Style Floating Glassmorphic Bottom Navigation Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#E60A192F"
            app:strokeColor="#1E3A8A"
            app:strokeWidth="1.2dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/navigation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                app:itemIconTint="@color/bg_nav_item"
                app:itemTextColor="@color/bg_nav_item"
                app:itemRippleColor="#330066FF"
                app:menu="@menu/menu_bottom_nav" />
        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
