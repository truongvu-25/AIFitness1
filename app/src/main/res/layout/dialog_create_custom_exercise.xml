<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#E60A192F"
    app:strokeColor="@color/mp_color_primary_variant"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TỰ TẠO BÀI TẬP MỚI"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:letterSpacing="0.04"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tùy chỉnh bài tập theo ý muốn và lưu vào thư viện"
            android:textSize="12sp"
            android:textColor="@color/tri_force_silver"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"/>

        <!-- Exercise Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên bài tập (vd: Hít đất kim cương)"
            android:textColorHint="#94A3B8"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/mp_color_primary_variant"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tri_force_white"
                android:inputType="textCapWords"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category Selector (Không dụng cụ / Tại nhà / Phòng gym) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hình thức tập luyện:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:layout_marginBottom="6dp"/>

        <RadioGroup
            android:id="@+id/rgCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbNoEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không dụng cụ"
                android:textSize="12sp"
                android:textColor="@color/tri_force_white"
                android:checked="true"
                android:buttonTint="@color/mp_color_primary_variant"/>

            <RadioButton
                android:id="@+id/rbHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tại nhà"
                android:textSize="12sp"
                android:textColor="@color/tri_force_white"
                android:layout_marginStart="8dp"
                android:buttonTint="@color/mp_color_primary_variant"/>

            <RadioButton
                android:id="@+id/rbGym"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phòng gym"
                android:textSize="12sp"
                android:textColor="@color/tri_force_white"
                android:layout_marginStart="8dp"
                android:buttonTint="@color/mp_color_primary_variant"/>
        </RadioGroup>

        <!-- Equipment Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dụng cụ yêu cầu (vd: Bodyweight, Tạ đơn 5kg...)"
            android:textColorHint="#94A3B8"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/mp_color_primary_variant"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bodyweight"
                android:textColor="@color/tri_force_white"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target Count Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mục tiêu (vd: 15 lần hoặc 45 giây)"
            android:textColorHint="#94A3B8"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/mp_color_primary_variant"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mục tiêu: 15 lần"
                android:textColor="@color/tri_force_white"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả kỹ thuật / nhóm cơ tác động"
            android:textColorHint="#94A3B8"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="18dp"
            app:boxStrokeColor="@color/mp_color_primary_variant"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tri_force_white"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancelCustom"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="HỦY"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_silver"
                android:backgroundTint="#26FFFFFF"
                app:cornerRadius="14dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSaveCustom"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="LƯU BÀI TẬP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="@color/mp_color_primary"
                app:cornerRadius="14dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
