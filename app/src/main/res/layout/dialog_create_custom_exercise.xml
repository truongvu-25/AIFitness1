<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/tri_force_white"
    app:strokeColor="@color/tri_force_stroke"
    app:strokeWidth="@dimen/stroke_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:text="@string/custom_exercise_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_text_primary"
            android:letterSpacing="0.04"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:text="@string/custom_exercise_subtitle"
            android:textSize="12sp"
            android:textColor="@color/tri_force_text_secondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"/>

        <!-- Exercise Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_exercise_name_hint"
            android:textColorHint="@color/input_hint"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/library_input_stroke"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tri_force_text_primary"
                android:inputType="textCapWords"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category Selector (Không dụng cụ / Tại nhà / Phòng gym) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:text="@string/custom_exercise_mode"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_text_primary"
            android:layout_marginBottom="6dp"/>

        <RadioGroup
            android:id="@+id/rgCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbNoEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:text="@string/custom_exercise_no_equipment"
                android:textSize="12sp"
                android:textColor="@color/tri_force_text_primary"
                android:checked="true"
                android:buttonTint="@color/mp_color_primary_variant"/>

            <RadioButton
                android:id="@+id/rbHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:text="@string/custom_exercise_home"
                android:textSize="12sp"
                android:textColor="@color/tri_force_text_primary"
                android:layout_marginStart="8dp"
                android:buttonTint="@color/mp_color_primary_variant"/>

            <RadioButton
                android:id="@+id/rbGym"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:text="@string/custom_exercise_gym"
                android:textSize="12sp"
                android:textColor="@color/tri_force_text_primary"
                android:layout_marginStart="8dp"
                android:buttonTint="@color/mp_color_primary_variant"/>
        </RadioGroup>

        <!-- Equipment Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_exercise_equipment_hint"
            android:textColorHint="@color/input_hint"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/library_input_stroke"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bodyweight"
                android:textColor="@color/tri_force_text_primary"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target Count Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_exercise_target_hint"
            android:textColorHint="@color/input_hint"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/library_input_stroke"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/camera_target_placeholder"
                android:textColor="@color/tri_force_text_primary"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_exercise_description_hint"
            android:textColorHint="@color/input_hint"
            app:hintTextColor="@color/mp_color_primary_variant"
            android:layout_marginBottom="18dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/library_input_stroke"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tri_force_text_primary"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancelCustom"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
        android:text="@string/action_cancel"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_blue"
                android:backgroundTint="@color/tri_force_white"
                app:cornerRadius="@dimen/button_corner_radius"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSaveCustom"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
        android:text="@string/action_save_exercise"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"
                android:backgroundTint="@color/mp_color_primary"
                app:cornerRadius="@dimen/button_corner_radius"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
