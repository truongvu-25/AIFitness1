<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_navy">

    <!-- Background Wallpaper -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/welcome_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark Layer Protection matching Logo Tone -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80050811"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Center Hero Branding Section -->
    <LinearLayout
        android:id="@+id/centerBrandingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Unclipped, Large Tri Force Logo -->
        <ImageView
            android:id="@+id/ivWelcomeLogo"
            android:layout_width="280dp"
            android:layout_height="240dp"
            android:src="@drawable/tri_force_logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <!-- App Brand Title -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRI FORCE"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:letterSpacing="0.14"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="10"
            android:layout_marginTop="12dp"/>

        <!-- Slogan -->
        <TextView
            android:id="@+id/tvWelcomeTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SỨC MẠNH • KỶ LUẬT • BỨT PHÁ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/mp_color_primary_variant"
            android:letterSpacing="0.18"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Bottom Action Section with Single CTA Button -->
    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/welcomeProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone"
            android:indeterminateTint="@color/mp_color_primary_variant"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnWelcomeStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="BẮT ĐẦU NGAY"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:letterSpacing="0.1"
            android:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="14dp"
            app:elevation="8dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
