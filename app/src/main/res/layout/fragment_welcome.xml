<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_navy">

    <!-- Full-Screen Athletic Wallpaper with Dark Seamless Scrim -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/welcome_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark Tint Protection Overlay to match logo dark tone -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66050811"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Perfectly Centered Branding Hero (Logo & Title) -->
    <LinearLayout
        android:id="@+id/centerBrandingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Prominent Extra-Large Tri Force Logo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogo"
            android:layout_width="240dp"
            android:layout_height="240dp"
            app:cardCornerRadius="120dp"
            app:cardBackgroundColor="#E6050811"
            app:cardElevation="16dp"
            app:strokeColor="@color/mp_color_primary_variant"
            app:strokeWidth="3.5dp">

            <ImageView
                android:id="@+id/ivWelcomeLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tri_force_logo"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRI FORCE"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:letterSpacing="0.16"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="10"
            android:layout_marginTop="20dp"/>

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvWelcomeTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SỨC MẠNH • KỶ LUẬT • BỨT PHÁ"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/mp_color_primary_variant"
            android:letterSpacing="0.2"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Bottom Action Section with Single CTA Button -->
    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/welcomeProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone"
            android:indeterminateTint="@color/mp_color_primary_variant"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnWelcomeStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="BẮT ĐẦU NGAY"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:letterSpacing="0.1"
            android:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="16dp"
            app:elevation="10dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
