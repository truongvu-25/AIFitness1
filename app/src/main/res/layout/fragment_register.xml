<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tri_force_navy"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Header Branding Section -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    app:cardCornerRadius="38dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/tri_force_navy"
                    app:strokeColor="@color/mp_color_primary_variant"
                    app:strokeWidth="2.5dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tri_force_logo"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/app_name"/>
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/ivTitleLogo"
                    android:layout_width="220dp"
                    android:layout_height="56dp"
                    android:src="@drawable/tri_force_text_logo"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_header_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/tri_force_silver"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Dark Themed Register Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/tri_force_dark_card"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1.5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_title"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="20dp"
                        android:layout_gravity="center_horizontal"/>

                    <!-- Email Input Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/register_email_hint"
                        android:textColorHint="#94A3B8"
                        app:hintTextColor="@color/mp_color_primary_variant"
                        app:placeholderText="@string/register_email_placeholder"
                        app:placeholderTextColor="#64748B"
                        android:layout_marginBottom="16dp"
                        app:boxStrokeColor="@color/mp_color_primary_variant"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_white"
                            android:textColorHighlight="#330066FF"
                            android:inputType="textEmailAddress"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/register_password_hint"
                        android:textColorHint="#94A3B8"
                        app:hintTextColor="@color/mp_color_primary_variant"
                        app:placeholderText="@string/register_password_placeholder"
                        app:placeholderTextColor="#64748B"
                        android:layout_marginBottom="16dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/mp_color_primary_variant"
                        app:boxStrokeColor="@color/mp_color_primary_variant"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_white"
                            android:textColorHighlight="#330066FF"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password Input Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/register_confirm_password_hint"
                        android:textColorHint="#94A3B8"
                        app:hintTextColor="@color/mp_color_primary_variant"
                        app:placeholderText="@string/register_confirm_password_placeholder"
                        app:placeholderTextColor="#64748B"
                        android:layout_marginBottom="24dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/mp_color_primary_variant"
                        app:boxStrokeColor="@color/mp_color_primary_variant"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tri_force_white"
                            android:textColorHighlight="#330066FF"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="@string/register_btn"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tri_force_white"
                        android:letterSpacing="0.08"
                        android:backgroundTint="@color/mp_color_primary"
                        app:cornerRadius="14dp"
                        app:elevation="6dp"/>

                    <ProgressBar
                        android:id="@+id/registerProgress"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/mp_color_primary_variant"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Redirect to Login -->
            <LinearLayout
                android:id="@+id/redirectLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_have_account"
                    android:textColor="@color/tri_force_silver"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_login_now"
                    android:textColor="@color/mp_color_primary_variant"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:padding="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
