<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/tri_force_navy"

    android:paddingStart="@dimen/space_24"
    android:paddingEnd="@dimen/space_24">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"
        android:scrollbars="none"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:gravity="center_horizontal"

            android:paddingTop="@dimen/space_20"
            android:paddingBottom="@dimen/space_32">


            <!-- =================================================
                 TRI FORCE BRANDING
                 ================================================= -->

            <LinearLayout
                android:id="@+id/headerLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:gravity="center_horizontal">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="68dp"
                    android:layout_height="68dp"

                    app:cardBackgroundColor="@color/tri_force_navy_deep"

                    app:cardCornerRadius="34dp"

                    app:cardElevation="0dp"

                    app:strokeColor="@color/tri_force_blue"
                    app:strokeWidth="@dimen/stroke_medium">


                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:src="@drawable/tri_force_logo"

                        android:scaleType="centerCrop"

                        android:contentDescription="@string/app_name" />


                </com.google.android.material.card.MaterialCardView>


                <ImageView
                    android:id="@+id/ivTitleLogo"

                    android:layout_width="200dp"
                    android:layout_height="48dp"

                    android:layout_marginTop="@dimen/space_8"

                    android:src="@drawable/tri_force_text_logo"

                    android:scaleType="fitCenter"

                    android:adjustViewBounds="true"

                    android:contentDescription="@string/app_name" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="@dimen/space_4"

                    android:text="@string/register_header_subtitle"

                    android:textColor="@color/tri_force_text_on_dark_secondary"

                    android:textSize="13sp"

                    android:includeFontPadding="false" />


            </LinearLayout>


            <!-- =================================================
                 REGISTER FORM
                 ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegister"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_20"

                app:cardBackgroundColor="@color/tri_force_white"

                app:cardCornerRadius="@dimen/card_corner_radius"

                app:cardElevation="0dp"

                app:strokeColor="@color/tri_force_stroke"
                app:strokeWidth="@dimen/stroke_thin">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="@dimen/card_padding_large">


                    <!-- Title -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/register_title"

                        android:textColor="@color/tri_force_text_primary"

                        android:textSize="20sp"
                        android:textStyle="bold"

                        android:gravity="center"

                        android:letterSpacing="0.05"

                        android:includeFontPadding="false" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="@dimen/space_4"
                        android:layout_marginBottom="@dimen/space_20"

                    android:text="@string/register_form_subtitle"

                        android:textColor="@color/tri_force_text_secondary"

                        android:textSize="12sp"

                        android:gravity="center"

                        android:includeFontPadding="false" />


                    <!-- =================================================
                         EMAIL
                         ================================================= -->

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="@dimen/space_12"

                        android:hint="@string/register_email_hint"

                        app:boxBackgroundColor="@color/input_background"

                        app:boxStrokeColor="@color/input_border_focused"

                        app:boxStrokeWidth="@dimen/stroke_thin"

                        app:boxStrokeWidthFocused="@dimen/stroke_medium"

                        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"

                        app:hintTextColor="@color/tri_force_text_secondary"

                        app:placeholderText="@string/register_email_placeholder"

                        app:placeholderTextColor="@color/input_hint">


                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterEmail"

                            android:layout_width="match_parent"
                            android:layout_height="56dp"

                            android:inputType="textEmailAddress"

                            android:textColor="@color/tri_force_text_primary"

                            android:textColorHint="@color/input_hint"

                            android:textColorHighlight="@color/tri_force_blue_light"

                            android:textSize="15sp"

                            android:singleLine="true" />


                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- =================================================
                         PASSWORD
                         ================================================= -->

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="@dimen/space_12"

                        android:hint="@string/register_password_hint"

                        app:boxBackgroundColor="@color/input_background"

                        app:boxStrokeColor="@color/input_border_focused"

                        app:boxStrokeWidth="@dimen/stroke_thin"

                        app:boxStrokeWidthFocused="@dimen/stroke_medium"

                        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"

                        app:hintTextColor="@color/tri_force_text_secondary"

                        app:placeholderText="@string/register_password_placeholder"

                        app:placeholderTextColor="@color/input_hint"

                        app:passwordToggleEnabled="true"

                        app:passwordToggleTint="@color/tri_force_blue">


                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterPassword"

                            android:layout_width="match_parent"
                            android:layout_height="56dp"

                            android:inputType="textPassword"

                            android:textColor="@color/tri_force_text_primary"

                            android:textColorHint="@color/input_hint"

                            android:textColorHighlight="@color/tri_force_blue_light"

                            android:textSize="15sp"

                            android:singleLine="true" />


                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- =================================================
                         CONFIRM PASSWORD
                         ================================================= -->

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="@dimen/space_20"

                        android:hint="@string/register_confirm_password_hint"

                        app:boxBackgroundColor="@color/input_background"

                        app:boxStrokeColor="@color/input_border_focused"

                        app:boxStrokeWidth="@dimen/stroke_thin"

                        app:boxStrokeWidthFocused="@dimen/stroke_medium"

                        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"

                        app:hintTextColor="@color/tri_force_text_secondary"

                        app:placeholderText="@string/register_confirm_password_placeholder"

                        app:placeholderTextColor="@color/input_hint"

                        app:passwordToggleEnabled="true"

                        app:passwordToggleTint="@color/tri_force_blue">


                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"

                            android:layout_width="match_parent"
                            android:layout_height="56dp"

                            android:inputType="textPassword"

                            android:textColor="@color/tri_force_text_primary"

                            android:textColorHint="@color/input_hint"

                            android:textColorHighlight="@color/tri_force_blue_light"

                            android:textSize="15sp"

                            android:singleLine="true" />


                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- =================================================
                         REGISTER BUTTON
                         ================================================= -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"

                        style="@style/TriForceButtonPrimary"

                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"

                        android:text="@string/register_btn"

                        android:textSize="15sp"

                        android:letterSpacing="0.06"

                        app:elevation="0dp" />


                    <ProgressBar
                        android:id="@+id/registerProgress"

                        android:layout_width="36dp"
                        android:layout_height="36dp"

                        android:layout_gravity="center"

                        android:layout_marginTop="@dimen/space_12"

                        android:indeterminateTint="@color/tri_force_blue"

                        android:visibility="gone" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================================================
                 LOGIN REDIRECT
                 ================================================= -->

            <LinearLayout
                android:id="@+id/redirectLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/space_16"

                android:orientation="horizontal"

                android:gravity="center">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/register_have_account"

                    android:textColor="@color/tri_force_text_on_dark_secondary"

                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/tvGoToLogin"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/register_login_now"

                    android:textColor="@color/tri_force_blue"

                    android:textStyle="bold"

                    android:textSize="14sp"

                    android:padding="8dp" />


            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
