<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Toggle CM / IN -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@color/tri_force_bg"
        android:padding="3dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnitCm"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:text="CM"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnitIn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:text="IN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_slate"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

    </LinearLayout>

    <!-- Bánh xe cuộn số -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <!-- Thanh nền làm nổi bật số đang chọn ở giữa -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_wheel_highlight" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHeightWheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_wheel_number" />

    </FrameLayout>

</LinearLayout>