<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_badge_info"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/height_unit_metric"
        android:textColor="@color/mp_color_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Bánh xe cuộn số -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <!-- Thanh nền làm nổi bật số đang chọn ở giữa -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_wheel_highlight" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHeightWheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_wheel_number" />

    </FrameLayout>

</LinearLayout>
