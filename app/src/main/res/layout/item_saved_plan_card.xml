<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSavedPlanRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#D90A192F"
    app:strokeColor="#1E3A8A"
    app:strokeWidth="1.2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top-Left Delete 'x' Button -->
        <ImageView
            android:id="@+id/btnDeletePlan"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/tri_force_error"
            android:background="#26EF4444"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/profile_title"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnDeletePlan"
            android:layout_toStartOf="@id/btnStartSavedPlan"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvSavedPlanBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch mẫu"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/mp_color_primary_variant"
                    android:background="#260066FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"/>

                <TextView
                    android:id="@+id/tvActiveIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐANG ÁP DỤNG"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/tri_force_success"
                    android:background="#2610B981"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSavedPlanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch tập tăng cơ 6 ngày"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/tri_force_white"/>

            <TextView
                android:id="@+id/tvSavedPlanDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 buổi tập/tuần • Lặp lại hàng tuần"
                android:textSize="12sp"
                android:textColor="@color/tri_force_silver"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Right Side BẮT ĐẦU Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSavedPlan"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="ÁP DỤNG"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/tri_force_white"
            app:backgroundTint="@color/mp_color_primary"
            app:cornerRadius="19dp"
            app:elevation="0dp"
            android:paddingHorizontal="14dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
