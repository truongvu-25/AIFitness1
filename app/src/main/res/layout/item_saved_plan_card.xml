<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/cardSavedPlanRoot"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="@dimen/space_4"
    android:layout_marginBottom="@dimen/space_8"

    app:cardBackgroundColor="@color/tri_force_white"

    app:cardCornerRadius="@dimen/card_corner_radius_small"

    app:cardElevation="0dp"

    app:strokeColor="@color/tri_force_stroke"
    app:strokeWidth="@dimen/stroke_thin">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="@dimen/card_padding">


        <!-- =====================================================
             TOP ROW
             Badges + Delete
             ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:gravity="center_vertical">


            <!-- Badge container -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <!-- Plan type -->

                <TextView
                    android:id="@+id/tvSavedPlanBadge"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:background="@drawable/bg_badge_info"

                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    android:text="Lịch mẫu"

                    android:textColor="@color/mp_color_primary"

                    android:textSize="11sp"
                    android:textStyle="bold"

                    android:includeFontPadding="false" />


                <!-- Active -->

                <TextView
                    android:id="@+id/tvActiveIndicator"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/space_8"

                    android:background="@drawable/bg_badge_success"

                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    android:text="ĐANG ÁP DỤNG"

                    android:textColor="@color/tri_force_success"

                    android:textSize="10sp"
                    android:textStyle="bold"

                    android:includeFontPadding="false"

                    android:visibility="gone" />

            </LinearLayout>


            <!-- Delete -->

            <ImageButton
                android:id="@+id/btnDeletePlan"

                android:layout_width="40dp"
                android:layout_height="40dp"

                android:layout_marginStart="@dimen/space_12"

                android:background="@drawable/bg_delete_action"

                android:src="@drawable/ic_delete_outline"

                android:padding="10dp"

                android:scaleType="centerInside"

                android:clickable="true"
                android:focusable="true"

                android:contentDescription="@string/profile_title" />

        </LinearLayout>


        <!-- =====================================================
             PLAN NAME
             ===================================================== -->

        <TextView
            android:id="@+id/tvSavedPlanName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_12"

            android:text="Lịch tập tăng cơ 6 ngày"

            android:textColor="@color/tri_force_text_primary"

            android:textSize="18sp"
            android:textStyle="bold"

            android:includeFontPadding="false"

            android:maxLines="2" />


        <!-- =====================================================
             DESCRIPTION
             ===================================================== -->

        <TextView
            android:id="@+id/tvSavedPlanDesc"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_4"

            android:text="6 buổi tập/tuần • Lặp lại hàng tuần"

            android:textColor="@color/tri_force_text_secondary"

            android:textSize="13sp"

            android:includeFontPadding="false" />


        <!-- =====================================================
             ACTION
             ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSavedPlan"

            style="@style/TriForceButtonPrimary"

            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"

            android:layout_marginTop="@dimen/space_16"

            android:text="Áp dụng lịch tập"

            android:textSize="14sp"

            app:elevation="0dp" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
